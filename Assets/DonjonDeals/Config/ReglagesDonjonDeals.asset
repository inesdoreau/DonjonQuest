  pactes:
  - id: ivresse
    famille: 1
    nom: L'ivresse
    gain: Tu cours 40 % plus vite.
    prix: "Tes commandes d\xE9rivent lentement sur elles-m\xEAmes."
    resume: "+40 % de vitesse \xB7 commandes qui d\xE9rivent"
    groupe: 0
